<launch>
  <arg name="scan_topic" default="/scan_filtered" />
  <arg name="raw_scan_topic" default="/scan" />
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="sensor_timeout" default="8.0" />
  <arg name="observe_window" default="10.0" />
  <arg name="front_angle_deg" default="20.0" />
  <arg name="min_obstacle_distance" default="0.60" />
  <arg name="stop_vel_threshold" default="0.05" />

  <node pkg="robot_slam" type="radar_self_check.py" name="radar_self_check" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)" />
    <param name="raw_scan_topic" value="$(arg raw_scan_topic)" />
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <param name="sensor_timeout" value="$(arg sensor_timeout)" />
    <param name="observe_window" value="$(arg observe_window)" />
    <param name="front_angle_deg" value="$(arg front_angle_deg)" />
    <param name="min_obstacle_distance" value="$(arg min_obstacle_distance)" />
    <param name="stop_vel_threshold" value="$(arg stop_vel_threshold)" />
  </node>
</launch>
